def clean(m):                   #Removes digitisation noise
    M=m
    indexs=np.where( m > 60000)
    row_index=indexs[0]
    column_index=indexs[1]
    for i, j in zip(row_index, column_index):
        M[i,j]=0
    return M  
  
def flat_noise(m):              #m is a 2D matrix.
    M=clean(m) 
    z=M[0:100,0:100] 
    z=z.ravel()
    average=np.average(z)
    shape=np.zeros((400,1880))
    for j in range(0,1880):
        for i in range(0,400):
            shape[i,j]=average
    return shape

