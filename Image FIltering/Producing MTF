#functions required
def calculate_1dft(input):
    ft = np.fft.ifftshift(input)
    ft = np.fft.fft(ft)
    return np.fft.fftshift(ft)

def M_dig(dx, fx, fy):                                          #MTF digitisation. Note, I want in term of k. I think fx == kx, fy == ky in this case but will just check before implimentation.
    p=(np.sin(np.pi * dx *fx))/(np.pi * dx *fx)
    q=(np.sin(np.pi * dx *fy))/(np.pi * dx *fy)
    return(p*q)

def M_fc(f,alpha_1,alpha_2,sigma_1,sigma_2):                    #MTF framing camera. Smalyuk only defines it in terms of the total f/k. alphas/sigmas are experimentall determined
    p=alpha_1*np.exp(-(sigma_1 * f)**2)
    q=alpha_2*np.exp(-(sigma_2 * f)**2)
    return(p+q)

def circ(x,y,R):
    rho= x**2 + y**2** - (R)**2
    return(rho)

def f(x_,y_,R,wavelength,x,y,z_1,z_2):
    p=circ(x_,y_,R)
    q=np.exp((-1j*np.pi/wavelength) * (x_**2 + y_**2)*(1/z_1 + 1/z_2))
    r=np.exp((-2j*np.pi/wavelength*z_2) * (x *x_ + y* y_)) 

    return p*q*r

def P_ph(R,wavelength,x,y,z_1,z_2):                            #PSF of the pinholes. Will lake fft to get the MTF. What the hell do i integrate over? Area of the pinhole camera probably?
    return (1/(wavelength**2 * z_1**2 * z_2**2))*np.abs(integrate.dblquad(f,-10,10,-10,10, args=(R,wavelength,x,y,z_1,z_2)))[0]**2

def M_ph(n,R,wavelength,z_1,z_2):                              #MTF of pineholes, n is dim of space
    x_data=np.arange(0,n)
    y_data=(np.arange(0,n))
    store=np.empty([n,n])
    for j in range(0,n):
        temp_store=np.array([])
        for i in range(0,n):
            p=P_ph(R,wavelength, x_data[i], y_data[j], z_1, z_2)
            temp_store=np.append(temp_store, p)
        q= calculate_1dft(temp_store)
        store[j]=np.abs(q)
    return store


