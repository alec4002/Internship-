import numpy as np
from scipy import signal, datasets
import matplotlib.pyplot as plt
import skimage

def calculate_2dft(input):
    ft = np.fft.ifftshift(input)
    ft = np.fft.fft2(ft)
    return np.fft.fftshift(ft)


# Read and process image
image = np.load('C:\Internship\Internship-\Image FIltering\Strip_2_clean.npy')
#image = image[:, :, :3].mean(axis=2)  # Convert to grayscale (THIS WAS WHAT I NEEDED!!!!)

Circle_1=image[0:400,100:500]
Circle_2=image[0:400,560:960]
Circle_3=image[0:400,1000:1400]
Circle_4=image[0:400,1450:1850]

#the following set of code produces a hann filter of dim nxn to use 
n=25 #length of Hann axis
win = skimage.filters.window('hann', (n, n))
x = 200 #x is the centre point, symmetric so just need one number
filter=np.zeros((400,400))

for j in range(int(x-n/2),int(x+n/2)):
    for i in range(int(x-n/2),int(x+n/2)):
            filter[i,j]=win[i-int((x-n/2)),j-int((x-n/2))]


#fourier transfer of the images 
ft_1 = calculate_2dft(Circle_1)
ft_2 = calculate_2dft(Circle_2)  
ft_3 = calculate_2dft(Circle_3)  
ft_4 = calculate_2dft(Circle_4)   

