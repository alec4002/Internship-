import numpy as np
import matplotlib.pyplot as plt

def calculate_2dft(input):
    ft = np.fft.ifftshift(input)
    ft = np.fft.fft2(ft)
    return np.fft.fftshift(ft)


# Read and process image
image = np.load('C:\Internship\Internship-\Image FIltering\Strip_2_aveage.npy')
#image = image[:, :, :3].mean(axis=2)  # Convert to grayscale (THIS WAS WHAT I NEEDED!!!!)

#create the range of k_x, k_y values
Sampling_freq_x=np.sort(np.fft.fftfreq(len(image[:,0])))
Sampling_freq_y=np.sort(np.fft.fftfreq(len(image[0,:])))


#making the k space
K_tot=np.empty([300,300])

for i in range(0,len(Sampling_freq_x)):
    q=np.array([])
    for j in range(0,len(Sampling_freq_y)):
        p=(Sampling_freq_y[j]**2 + Sampling_freq_x[i]**2)**(1/2)
        q=np.append(q,p)
    K_tot[i]=q

#fourier transfer of the image 
ft = calculate_2dft(image)   

for j in range(0,300):
    for i in range(0,300):
        if (i-150)**2 + (j-150)**2 >= 30**2: #and (i-200)**2 + (j-300)**2 >= 145**2 :
            ft[i,j]=0


plt.figure()
plt.subplot(1,2,1)
plt.imshow(np.log1p(np.abs(ft)))

plt.subplot(1,2,2)
plt.imshow(np.abs(np.fft.ifftshift(np.fft.ifft2(ft))))
plt.show()


