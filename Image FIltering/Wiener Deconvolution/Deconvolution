import matplotlib.pyplot as plt
import numpy as np
import matplotlib.colors as colors
import scipy 
from scipy import integrate

def calculate_2dft(input):
    ft = np.fft.ifftshift(input)
    ft = np.fft.fft2(ft)
    return np.fft.fftshift(ft)

#image data
Signal=np.load('C:\Internship\Internship-\Image FIltering\Wiener Deconvolution\ Signal.npy') 
Noise=np.load('C:\Internship\Internship-\Image FIltering\Wiener Deconvolution\ Noise.npy') 
Measured=np.load('C:\Internship\Internship-\Image FIltering\Wiener Deconvolution\ Measured.npy') 

#Fourier Transforms
Mtf=np.load('C:\Internship\Internship-\Image FIltering\Wiener Deconvolution\Mtf.npy')
Signal_ft=calculate_2dft(Signal)
Noise_ft=calculate_2dft(Noise)
Measured_ft=calculate_2dft(Measured)

Mtf= Mtf

Restored= np.divide(Measured_ft, Mtf) * np.divide((np.abs(Signal_ft))**2, ((np.abs(Signal_ft))**2 + (np.abs(Noise_ft))**2))

plt.figure()
plt.imshow(np.abs(np.fft.ifftshift(np.fft.ifft2(Restored))))
plt.set_cmap('gray')
plt.show()