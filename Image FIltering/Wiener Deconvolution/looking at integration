import matplotlib.pyplot as plt
import numpy as np
import matplotlib.colors as colors
import scipy 
from scipy import integrate

def circ(x,y,z,w):
    rho= z*(x**2 + y**2)**(0.5) + w
    return(rho)

def integrate_(f,p,q):
    return integrate.dblquad(f,-1, 1, -1, 1, args=(p,q))

p=np.arange(0,10)
q=np.arange(0,10)

store=np.zeros((10,10))

for i in range (0,len(p)):
    for j in range(0,len(q)):
       store[i,j]= integrate_(circ, p[i], q[j])[0]


print((store))        