import numpy as np
import matplotlib.pyplot as plt

def calculate_2dft(input):
    ft = np.fft.ifftshift(input)
    ft = np.fft.fft2(ft)
    return np.fft.fftshift(ft)

# Read and process image
signal = np.load('C:\Internship\Internship-\Image FIltering\Wiener Deconvolution\ signal.npy')
noise = np.load('C:\Internship\Internship-\Image FIltering\Wiener Deconvolution\ noise.npy')
