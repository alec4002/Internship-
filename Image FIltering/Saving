def average_noise(m):            #m is a 2D matrix. This averaging gives a high value compared to the background i see; may need to increase the region if interest again  
    vals=np.array([])
    flat_m= m.ravel() 
    indexs= np.where((flat_m > 0) & (flat_m < 1000))[0]
    for j in indexs:
        vals=np.append(vals, flat_m[j])
    return(np.average(vals))

