import matplotlib.pyplot as plt
import numpy as np
import numpy as np
from scipy import signal, datasets, ndimage


Circle_1=np.load('C:\Internship\Internship-\Image FIltering\Frame alignment\Cirlce_1.npy')
Circle_2_new=np.load('C:\Internship\Internship-\Image FIltering\Frame alignment\Cirlce_2_new.npy')

Roi= Circle_2_new[240:280,185:245]

corr = signal.correlate2d(Circle_1, Roi, boundary='symm', mode='same')
y, x = np.unravel_index(np.argmax(corr), corr.shape)  # find the match

#Drawing rectangle
#Circle_2[245:285,175]=500
#Circle_2[245:285,235]=500
#Circle_2[245,175:235]=500
#Circle_2[285,175:235]=500

#Circle_2_new[250:290,185]=500
#Circle_2_new[250:290,245]=500
#Circle_2_new[250,185:245]=500
#Circle_2_new[290,185:245]=500

print(x,y)

plt.figure()
plt.subplot(2,2,1)
plt.imshow(Circle_1)
plt.plot(x,y, 'ro')
plt.clim(0,500)
plt.set_cmap('gray')
plt.title('Circle 1')
plt.legend()
plt.colorbar(location='bottom')

plt.subplot(2,2,2)
plt.imshow(Circle_2_new)
plt.plot(215,260, 'ro')
plt.clim(0,500)
plt.set_cmap('gray')
plt.title('Circle 2')
plt.legend()
plt.colorbar(location='bottom')

plt.subplot(2,2,3)
plt.imshow(Circle_1+Circle_2_new)
plt.clim(0,500)
plt.set_cmap('gray')
plt.title('Signal')
plt.legend()
plt.colorbar(location='bottom')

plt.subplot(2,2,4)
plt.imshow(Circle_1-Circle_2_new)
plt.clim(0,500)
plt.set_cmap('gray')
plt.title('Noise')
plt.legend()
plt.colorbar(location='bottom')

plt.savefig('C:\Internship\Internship-\Image FIltering\Frame alignment\Correlated images.png', bbox_inches='tight')
plt.show()