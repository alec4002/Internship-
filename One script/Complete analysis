def calculate_2dft(input):         
    """
    
    """  
    ft = np.fft.ifftshift(input)
    ft = np.fft.fft2(ft)
    return np.fft.fftshift(ft)


def Haan_filter(n,d):            
    """
    This function produces a haan filter of n size on an array of size dxd. Assuming the Haan filtered is centred in the array
    """
    win = skimage.filters.window('hann', (n, n))
    Haan_filter=np.empty((d,d))
    y,x = int(d/2),int(d/2)                             #x,y is the centre point

    for j in range(int(y-n/2),int(y+n/2)):
        for i in range(int(x-n/2),int(x+n/2)):
            Haan_filter[i,j]=win[i-int((x-n/2)),j-int((y-n/2))]

    return Haan_filter

def makeGaussian( M, Amp, rank, std_x, std_y, theta, centre_x, centre_y):    #this code comes from stack overflow, modified to be elliptical and have rotation. see link, https://stackoverflow.com/questions/7687679/how-to-generate-2d-gaussian-with-python
    """ Make a square gaussian kernel.                             #theta mus be [-pi/4, pi/4]
                                                                    #M is  Nx2 matrix where N is the no of data 
    size is the length of a side of the square
    fwhm is full-width-half-maximum, which
    can be thought of as an effective radius.
    """

    x, y= M

    x0 = centre_x
    y0 = centre_y


    a= ((np.cos(theta))**2/(2*std_x**2))+((np.sin(theta))**2/(2*std_y**2))     
    b= -((np.cos(theta) * np.sin(theta))/(2*std_x**2))+((np.cos(theta) * np.sin(theta))/(2*std_y**2))   
    c= ((np.sin(theta))**2/(2*std_x**2))+((np.cos(theta))**2/(2*std_y**2))

    return (Amp*np.exp(-(a*((x-x0)**2) + 2*b*(x-x0)*(y-y0) + c*((y-y0)**2))**rank))

def Backlighter_fit(image,n):
    """
    Produces a fit of the backlighter profile of the corresponding image, with n denoting the sixe of the Haan filter. I've found n=15 works well. Print 
    line outs in the y and x axis to check the fit isn't doing anything weird. 
    """
    x, y = np.arange(0, 400), np.arange(0, 400)
    X, Y = np.meshgrid(x, y)

    Filter=makeGaussian((X,Y),1,2,5,5,0,200,200)
    Backlighter= np.abs(np.fft.ifftshift(np.fft.ifft2(calculate_2dft(image)*Haan_filter(n,len(image)))))      #Backlighter profile for this shot

    xdata = np.vstack((X.ravel(), Y.ravel()))

    #turning space, data into 1D arrays so curve fit can work
    ydata= Backlighter.ravel()

    #initial guesses; may have issues with the centre
    p0=([np.max(ydata),1,100,100,0,200,200])

    #Getting params 
    popt, pcov = curve_fit(makeGaussian, xdata, ydata, p0)

    #getting the optimised values
    Amp=popt[0]
    rank=popt[1]
    std_x=popt[2]
    std_y=popt[3]
    theta=popt[4]
    centre_x=popt[5]
    centre_y=popt[6]

    #getting the errors
    errors=np.array([])
    for i in range(0,len(pcov)):
        errors=np.append(errors, pcov[i,i]**(0.5))

    #getting fit
    fit=makeGaussian((X,Y), Amp, rank,std_x,std_y,theta,centre_x, centre_y)

    return fit

