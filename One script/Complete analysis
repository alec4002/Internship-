def clean(m,q,w): 
    """"
    This fucntion removes to noise due to digitilisation. The photos are scanned in in vertically, hence there is some resiudal vertical noise which is much 
    higher that the intenisty of the shots. Hence we just set it to zero (intensity is usually highere than 60,000). m is the matix, q is the cut off value, 
    w is the value we set this to
    """                  
    M=m
    indexs=np.where( m < q)
    row_index=indexs[0]
    column_index=indexs[1]
    for i, j in zip(row_index, column_index):
        M[i,j]=w
    return M 

def flat_noise(m):              
    """"
    This creates a flat array of the same dimentions of the entry m of noise. This will be used to remove the background noise from the image
    """
    M=clean(m,0,0) 
    z=M[0:100,0:100] 
    z=z.ravel()
    average=np.average(z)
    shape=np.zeros((400,1880))
    for j in range(0,1880):
        for i in range(0,400):
            shape[i,j]=average
    return shape


