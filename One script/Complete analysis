def makeGaussianfilter(size, rank, std_x, std_y, theta, center=None):    #this code comes from stack overflow, modified to be elliptical and have rotation. see link, https://stackoverflow.com/questions/7687679/how-to-generate-2d-gaussian-with-python
    """ 
    This is slightly different gaussain code. This doesn't take a matrix for an input, as it did for the gaussian fit. We use this to create a low pass
    filter.
    """

    x = np.arange(0, size, 1, float)
    y = x[:,np.newaxis]

    if center is None:
        x0 = y0 = size // 2
    else:
        x0 = center[0]
        y0 = center[1]


    a= ((np.cos(theta))**2/(2*std_x**2))+((np.sin(theta))**2/(2*std_y**2))     
    b= -((np.cos(theta) * np.sin(theta))/(2*std_x**2))+((np.cos(theta) * np.sin(theta))/(2*std_y**2))   
    c= ((np.sin(theta))**2/(2*std_x**2))+((np.cos(theta))**2/(2*std_y**2))

    return (np.exp(-(a*((x-x0)**2) + 2*b*(x-x0)*(y-y0) + c*((y-y0)**2))**rank))

