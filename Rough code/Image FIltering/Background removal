def average_noise(m):            #m is a 2D matrix. This averaging gives a high value compared to the background i see; may need to increase the region if interest again  
    vals=np.array([])            #This isnt useful. Will use scipy interpolation to get a flat noise image instead   
    flat_m= m.ravel() 
    indexs= np.where((flat_m > 0) & (flat_m < 1000))[0]
    for j in indexs:
        vals=np.append(vals, flat_m[j])
    return(np.average(vals))


def clean(m):                   #Removes digitisation noise
    M=m
    indexs=np.where( m > 60000)
    row_index=indexs[0]
    column_index=indexs[1]
    for i, j in zip(row_index, column_index):
        M[i,j]=0
    return M  
  
def flat_noise(m):              #m is a 2D matrix.
    M=clean(m) 
    z=M[0:100,0:100] 
    z=z.ravel()
    average=np.average(z)
    shape=np.zeros((400,1880))
    for j in range(0,1880):
        for i in range(0,400):
            shape[i,j]=average
    return shape

