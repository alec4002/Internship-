def Bin(m,p):   #m is matrix, p is the number of bins
    amps=np.array([])      
    bins=np.arange(0,np.max(m[:,0]),(np.max(np.max(m[:,0])))/p)
    for i in range(0, len(bins)):
        Test=bins[i]   
        Temp_store=np.array([])
        boolian= np.any( m <= Test, axis=1)
        indexs= np.where(boolian == True)[0]
        for i in indexs: 
            Temp_store=np.append(Temp_store, m[:,1][i])
        amps=np.append(amps, np.sum(Temp_store))
    bins=np.append(bins, (bins[-1]+(np.max(np.max(m[:,0])))/p))
    return(amps, bins)

counts, bins= Bin(Raw_sorted, 200)
