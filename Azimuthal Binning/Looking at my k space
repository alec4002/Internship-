#Binning k val duplicates. Note than m must be Nx2 dimensional
def Sort(m):
    amps=np.array([])
    k_vals=np.unique(m[:,0]) 
    for i in range(0,len(k_vals)):
        Temp_store=np.array([])
        Test=k_vals[i]
        boolian=np.any(m == Test, axis=1)
        indexs= np.where(boolian == True)[0] 
        for i in indexs: 
            Temp_store=np.append(Temp_store, m[:,1][i])
        amps=np.append(amps, np.sum(Temp_store))
    return(k_vals,amps)            
    

k_vals, Amps = (Sort(Tot))



def Bin(m,p):          #m matix, p no of enteries to be summed into single entry
    S=np.array([])
    for i in range(0,len(m), p):
        q= m[i:i+p]
        S=np.append(S,np.sum(q))
    return S 

